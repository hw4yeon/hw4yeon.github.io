# 로컬에서 미리보기 할 때만 필요합니다. (bundle install && bundle exec jekyll serve)
# GitHub에 푸시할 때는 없어도 알아서 빌드됩니다.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Ruby 3.4+ 부터 표준 라이브러리에서 빠진 gem들
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
